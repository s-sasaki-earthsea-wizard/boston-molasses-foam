FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D domain: x = 0..lengthX (flow), y = 0..20 m (height), z = 0..1 m (1 cell)
//
// The entries below are switched by scripts/set_step.sh <1-5>; keep one
// "key value;" per line.
//   Steps 1-4  x = 0..180 m, dx = dy = 0.5 m: 360 x 40 = 14,400 cells
//   Step 5     x = 0..400 m, dx = 0.5 m; dy = 0.05 m up to y = 2.5 m, growing
//              by ~4.9 % per cell to 0.49 m at y = 12 m (the column top),
//              0.5 m above: 800 x 114 = 91,200 cells
// MESH_REFINE multiplies cellsX and cellsY; the grading keeps its shape.
// gradingY lists (length, cells, last/first cell size) per section; blockMesh
// normalises the lengths and cell numbers.

scale   1;

lengthX         180;                // [m]
cellsX          360;
cellsY          40;
gradingY        1;

vertices
(
    (       0   0 0)
    ($lengthX   0 0)
    ($lengthX  20 0)
    (       0  20 0)
    (       0   0 1)
    ($lengthX   0 1)
    ($lengthX  20 1)
    (       0  20 1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($cellsX $cellsY 1) simpleGrading (1 $gradingY 1)
);

edges
(
);

boundary
(
    left
    {
        type wall;
        faces
        (
            (0 4 7 3)
        );
    }

    right
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }

    bottom
    {
        type wall;
        faces
        (
            (1 5 4 0)
        );
    }

    top
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);


