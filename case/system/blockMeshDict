FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D domain: x = 0..180 m (flow), y = 0..20 m (height), z = 0..1 m (1 cell)
// Isotropic dx = dy = 0.5 m -> 360 x 40 x 1 = 14,400 cells

scale   1;

vertices
(
    (  0   0  0)
    (180   0  0)
    (180  20  0)
    (  0  20  0)
    (  0   0  1)
    (180   0  1)
    (180  20  1)
    (  0  20  1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (360 40 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    left
    {
        type wall;
        faces
        (
            (0 4 7 3)
        );
    }

    right
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }

    bottom
    {
        type wall;
        faces
        (
            (1 5 4 0)
        );
    }

    top
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);


