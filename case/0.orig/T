FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Atmosphere at 4 degC; the liquid block (20 degC) is set by setFieldsDict.
// Walls are adiabatic.

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 277.15;

boundaryField
{
    left
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }

    right
    {
        type            inletOutlet;
        inletValue      uniform 277.15;
        value           uniform 277.15;
    }

    top
    {
        type            inletOutlet;
        inletValue      uniform 277.15;
        value           uniform 277.15;
    }

    frontAndBack
    {
        type            empty;
    }
}


