# -----------------------------------------------------------------------------
# case.mk - mesh generation, initialisation and the verification runs
#
#   case/0.orig   pristine initial/boundary conditions (version controlled)
#   case/0        generated by `make init` (0.orig + setFields)
#
# run-stepN switches the case to step N (scripts/set_step.sh: properties in
# transportProperties, initial liquid temperature in setFieldsDict, domain and
# mesh in blockMeshDict, endTime / writeInterval in controlDict), removes
# previous results and runs the solver; it builds the solver first if it is
# missing or out of date. The mesh and the initial fields are rebuilt after
# set_step.sh when it changed them.
# -----------------------------------------------------------------------------

# Stamps are touched only after success; OpenFOAM output names cannot be
# used as targets because writeCompression adds .gz (owner.gz, ...)
MESH_FILE     := $(CASE_DIR)/constant/polyMesh/.stamp
INIT_FILE     := $(CASE_DIR)/0/.stamp
STEPS         := 1 2 3 4 5
# Molasses viscosity of Steps 4-5 (scripts/set_step.sh): low, central or high
MOLASSES_MU   ?= central
# Mesh refinement factor of the step's mesh (cell numbers x MESH_REFINE) and
# overrides of the step's endTime / writeInterval (empty: the step's values)
MESH_REFINE   ?= 1
END_TIME      ?=
WRITE_INTERVAL ?=
RUN_STEPS     := $(addprefix run-step,$(STEPS))

BLOCKMESH_CMD := cd $(CASE_DIR) && blockMesh 2>&1 | tee log.blockMesh && touch constant/polyMesh/.stamp
SETFIELDS_CMD := cd $(CASE_DIR) && rm -rf 0 && cp -r 0.orig 0 && setFields 2>&1 | tee log.setFields && touch 0/.stamp

.PHONY: mesh init $(RUN_STEPS)

mesh: ## Generate the mesh with blockMesh (of the last set step)
	$(call foam,$(BLOCKMESH_CMD))

init: $(MESH_FILE) ## Reset 0/ from 0.orig and run setFields (liquid block, T of the last set step)
	$(call foam,$(SETFIELDS_CMD))

$(MESH_FILE): $(CASE_DIR)/system/blockMeshDict
	$(call foam,$(BLOCKMESH_CMD))

$(INIT_FILE): $(MESH_FILE) $(CASE_DIR)/system/setFieldsDict $(wildcard $(CASE_DIR)/0.orig/*)
	$(call foam,$(SETFIELDS_CMD))

run-step1: ## Step 1: isothermal water dam-break
run-step2: ## Step 2: water + heat exchange with the atmosphere
run-step3: ## Step 3: water + temperature-dependent viscosity
run-step4: ## Step 4: molasses wave stage (MOLASSES_MU=low|central|high, default central)
run-step5: ## Step 5: molasses spreading, 400 m, bottom-refined mesh, 120 s (MOLASSES_MU)

# set_step.sh may change the domain and mesh, so the mesh and 0/ are brought
# up to date after it (the $(INIT_FILE) rule depends on $(MESH_FILE))
$(RUN_STEPS): run-step%: $(SOLVER_BIN)
	MESH_REFINE=$(MESH_REFINE) END_TIME=$(END_TIME) WRITE_INTERVAL=$(WRITE_INTERVAL) \
		bash scripts/set_step.sh $* $(CASE_DIR) $(MOLASSES_MU)
	$(MAKE) --no-print-directory $(INIT_FILE)
	bash scripts/clean.sh $(CASE_DIR)
	$(call foam,cd $(CASE_DIR) && $(SOLVER_NAME) 2>&1 | tee log.$(SOLVER_NAME).step$*)
