# -----------------------------------------------------------------------------
# case.mk - mesh generation, initialisation and the verification runs
#
#   case/0.orig   pristine initial/boundary conditions (version controlled)
#   case/0        generated by `make init` (0.orig + setFields)
#
# run-stepN switches transportProperties to step N (scripts/set_step.sh),
# removes previous results and runs the solver; it builds the solver, the
# mesh and the initial fields first if they are missing or out of date.
# -----------------------------------------------------------------------------

# Stamps are touched only after success; OpenFOAM output names cannot be
# used as targets because writeCompression adds .gz (owner.gz, ...)
MESH_FILE     := $(CASE_DIR)/constant/polyMesh/.stamp
INIT_FILE     := $(CASE_DIR)/0/.stamp
STEPS         := 1 2 3 4
RUN_STEPS     := $(addprefix run-step,$(STEPS))

BLOCKMESH_CMD := cd $(CASE_DIR) && blockMesh 2>&1 | tee log.blockMesh && touch constant/polyMesh/.stamp
SETFIELDS_CMD := cd $(CASE_DIR) && rm -rf 0 && cp -r 0.orig 0 && setFields 2>&1 | tee log.setFields && touch 0/.stamp

.PHONY: mesh init $(RUN_STEPS)

mesh: ## Generate the mesh with blockMesh (360 x 40 x 1 cells)
	$(call foam,$(BLOCKMESH_CMD))

init: $(MESH_FILE) ## Reset 0/ from 0.orig and run setFields (liquid block, T)
	$(call foam,$(SETFIELDS_CMD))

$(MESH_FILE): $(CASE_DIR)/system/blockMeshDict
	$(call foam,$(BLOCKMESH_CMD))

$(INIT_FILE): $(MESH_FILE) $(CASE_DIR)/system/setFieldsDict $(wildcard $(CASE_DIR)/0.orig/*)
	$(call foam,$(SETFIELDS_CMD))

run-step1: ## Step 1: isothermal water dam-break
run-step2: ## Step 2: water + heat exchange with the atmosphere
run-step3: ## Step 3: water + temperature-dependent viscosity
run-step4: ## Step 4: Boston molasses (high density and viscosity)

$(RUN_STEPS): run-step%: $(SOLVER_BIN) $(INIT_FILE)
	bash scripts/set_step.sh $* $(CASE_DIR)
	bash scripts/clean.sh $(CASE_DIR)
	$(call foam,cd $(CASE_DIR) && $(SOLVER_NAME) 2>&1 | tee log.$(SOLVER_NAME).step$*)
